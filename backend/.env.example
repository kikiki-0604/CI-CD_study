# このファイルをコピーして backend/.env を作り、配られた Bedrock の API キーを入れてください。
#   Mac / Linux : cp backend/.env.example backend/.env
#   Windows     : copy backend\.env.example backend\.env
#
# ⚠️ backend/.env にはキーが入ります。GitHub に上げないでください(.gitignore で除外済み)。
#    この .env.example には、キーを書かないでください(こちらは GitHub に上がります)。

# 配られた Bedrock の API キーを、= の右側に貼る(前後に空白やカギ括弧を付けない)
AWS_BEARER_TOKEN_BEDROCK=

# 以下は変えなくてOK
AWS_REGION=ap-northeast-1
BEDROCK_MODEL_ID=jp.anthropic.claude-haiku-4-5-20251001-v1:0
