# --- 方式A: Bedrock APIキー(推奨・シンプル) ---
# VSCodeのClaude Code拡張と同じ「Bedrock APIキー」をそのまま使えます。
# これを設定すると、下のAWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEYは不要です。
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-northeast-1
BEDROCK_MODEL_ID=jp.anthropic.claude-haiku-4-5-20251001-v1:0

# --- 方式B: 従来のIAMアクセスキー方式 ---
# 方式Aを使う場合は空欄のままでOK(両方設定した場合はAPIキーが優先されます)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
